APP_NAME=Kudos
APP_ENV=production
APP_DEBUG=false
APP_URL=https://kudos.example.com
APP_KEY=                      # php artisan key:generate --show
LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kudos
DB_USERNAME=kudos
DB_PASSWORD=change-me         # also POSTGRES_PASSWORD for the db service
POSTGRES_USER=kudos
POSTGRES_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
TRUSTED_PROXIES=*

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
