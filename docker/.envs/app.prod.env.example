APP_NAME=Kudos
APP_ENV=production
APP_DEBUG=false
APP_URL=https://kudos.example.com
APP_KEY=                      # php artisan key:generate --show

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=kudos
DB_USERNAME=kudos
DB_PASSWORD=change-me         # also POSTGRES_PASSWORD for the db service
POSTGRES_USER=kudos
POSTGRES_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=database
CACHE_STORE=database
TRUSTED_PROXIES=*

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=

# ---- Logging: one JSON object per line on stderr, grouped who / what / where / when / why ----
LOG_CHANNEL=stderr_json
LOG_LEVEL=info
LOG_FORMAT=json
LOG_SERVICE=kudos
LOG_REQUEST_ID_HEADER=X-Request-ID
# access log: all | errors (4xx, 5xx, slow) | off
LOG_ACCESS=all
LOG_ACCESS_SLOW_MS=1000
LOG_TRACE_LIMIT=10

# ---- Resilience: retry with exponential backoff (outbound calls such as Stripe, queue jobs) ----
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=200
RETRY_MAX_DELAY_MS=5000
RETRY_FACTOR=2
# full | equal | none
RETRY_JITTER=full
# stop retrying once this much time has been spent in total (0 = attempts only)
RETRY_BUDGET_MS=15000

# ---- Outage page (edge): first check after, longest pause between checks (ms) ----
OUTAGE_FIRST_MS=4000
OUTAGE_LONGEST_MS=15000
