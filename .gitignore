# BEGIN AI-DLC:gitignore
# AI-DLC: local working files
aidlc/active-space
aidlc/spaces/*/intents/active-intent
aidlc/.aidlc-clone-id
aidlc.settings.local.json
aidlc/.aidlc-unit-scope.json
aidlc/.aidlc-unit-parked
aidlc/.aidlc-claim-generations.json
aidlc/.aidlc-unit-participant
aidlc/.aidlc-claim-registry.json
aidlc/.aidlc-unit-releases/
aidlc/.aidlc-unit-merges/
aidlc/.aidlc-active-space-*.tmp
aidlc/active-memory/
aidlc/.aidlc-sessions/
aidlc/.aidlc-request-text/
aidlc/spaces/*/intents/.aidlc-*
**/aidlc/spaces/*/intents/**/.aidlc-engine/
**/aidlc/spaces/*/intents/**/.aidlc-sensors/
aidlc/spaces/*/knowledge/documentkb/.journal/
aidlc/spaces/*/knowledge/.sources.local.json
aidlc/spaces/*/intents/*/runtime-graph.json
aidlc/spaces/*/intents/*/.aidlc-*
aidlc/diagnostics/
.aidlc/worktree-meta.json
.aidlc/base-source-listing.tsv
.claude/settings.local.json
# END AI-DLC:gitignore

# ---- secrets and local environment (never commit) ----
docker/.envs/app.env
docker/.envs/app.prod.env
docker/.envs/secrets/
codes/.env

# ---- build output and dependencies (rebuilt from the lockfiles) ----
codes/vendor/
codes/node_modules/
codes/public/build/
codes/public/hot
codes/bootstrap/ssr/

# ---- generated files ----
codes/public/status/lang.json
codes/lang/.lang.lock

# ---- Lighthouse reports: the summary and two sample reports are committed, the rest is regenerated by scripts/lighthouse-all.sh ----
docs/performance/*.report.json
docs/performance/*.report.html
!docs/performance/landing-mobile-light.report.html
!docs/performance/collect-mobile-dark.report.html

# ---- tool and editor noise ----
.claude/worktrees/
.DS_Store
.idea/
.vscode/
*.swp
*.log

# full screenshot capture set (every page, light/dark, desktop/mobile): regenerate locally; only docs/screenshots/readme/ is tracked
docs/screenshots/all/
.tmp-demo/
