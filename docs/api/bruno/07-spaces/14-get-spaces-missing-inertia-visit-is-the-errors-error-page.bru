meta {
  name: GET /spaces/{missing} (Inertia visit) is the errors/error page
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/spaces/{{missingId}}
  body: none
  auth: none
}

headers {
  X-Request-ID: {{requestId}}
  Accept: text/html, application/xhtml+xml
  X-Inertia: true
  X-Inertia-Version: {{inertiaVersion}}
  X-Requested-With: XMLHttpRequest
}

script:pre-request {
  const __setVar = (k, v) => bru.setVar(k, v);
  const __getVar = (k) => (bru.getVar(k) ?? bru.getEnvVar(k));
  // Generated by docs/api/build.py. Do not edit by hand.
  __setVar('requestId', 'kudos-api-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8));
  if (!__getVar('runId')) { const __id = Date.now().toString(36); __setVar('runId', __id); __setVar('spaceName', 'API Probe ' + __id); }
  req.setMaxRedirects(0);
}

script:post-response {
  const __setVar = (k, v) => bru.setVar(k, v);
  const __getVar = (k) => (bru.getVar(k) ?? bru.getEnvVar(k));
  const __status = res.getStatus();
  const __hdr = (n) => res.getHeader(n.toLowerCase());
  const __text = (typeof res.getBody() === 'string' ? res.getBody() : JSON.stringify(res.getBody()));
  const __setCookies = () => [].concat(res.getHeader('set-cookie') || []);
  let __j; try { __j = (typeof res.getBody() === 'object' && res.getBody() !== null ? res.getBody() : JSON.parse(res.getBody())); } catch (e) { __j = undefined; }
  const __get = (o, p) => { const k = []; p.replace(/\['([^']+)'\]|\[(\d+)\]|([^.\[\]]+)/g, (m, a, b, c) => { k.push(a !== undefined ? a : b !== undefined ? Number(b) : c); return m; }); return k.reduce((x, y) => (x == null ? undefined : x[y]), o); };
  for (const __c of [].concat(res.getHeader('set-cookie') || [])) { const __m = /^XSRF-TOKEN=([^;]+)/.exec(__c); if (__m) { __setVar('xsrfToken', decodeURIComponent(__m[1])); } }
  const __again = false;
}

tests {
  const __setVar = (k, v) => bru.setVar(k, v);
  const __getVar = (k) => (bru.getVar(k) ?? bru.getEnvVar(k));
  const __status = res.getStatus();
  const __hdr = (n) => res.getHeader(n.toLowerCase());
  const __text = (typeof res.getBody() === 'string' ? res.getBody() : JSON.stringify(res.getBody()));
  const __setCookies = () => [].concat(res.getHeader('set-cookie') || []);
  let __j; try { __j = (typeof res.getBody() === 'object' && res.getBody() !== null ? res.getBody() : JSON.parse(res.getBody())); } catch (e) { __j = undefined; }
  const __get = (o, p) => { const k = []; p.replace(/\['([^']+)'\]|\[(\d+)\]|([^.\[\]]+)/g, (m, a, b, c) => { k.push(a !== undefined ? a : b !== undefined ? Number(b) : c); return m; }); return k.reduce((x, y) => (x == null ? undefined : x[y]), o); };
  const __again = false;
  if (!__again) {
    test('echoes X-Request-ID', function () { expect(__hdr('X-Request-ID')).to.equal(__getVar('requestId')); });
    test("status is 404", function () { expect([404]).to.include(__status); });
    test("X-Inertia header matches true", function () { expect(String(__hdr("X-Inertia") || '')).to.match(new RegExp("true")); });
    test("json component eq \"errors/error\"", function () { expect(__get(__j, "component")).to.deep.equal("errors/error"); });
    test("json props.status eq 404", function () { expect(__get(__j, "props.status")).to.deep.equal(404); });
    test("json props.copyKey eq \"404\"", function () { expect(__get(__j, "props.copyKey")).to.deep.equal("404"); });
    test("json props.requestId eq \"{{requestId}}\"", function () { expect(__get(__j, "props.requestId")).to.deep.equal(__getVar("requestId")); });
  }
}

docs {
  Inertia clients get the failure as a page object (the React error page) with the real status, not a JSON error body or a reload.

  Mode: inertia. Expected status: 404.
}
