meta {
  name: POST /spaces (JSON) is 401
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/spaces
  body: json
  auth: none
}

headers {
  X-Request-ID: {{requestId}}
  Accept: application/json
  X-XSRF-TOKEN: {{xsrfToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "{{spaceName}}",
    "header_title": "Tell us what you think",
    "message": "Say **hi**",
    "collect_rating": true,
    "theme": "brand",
    "is_accepting": true,
    "fields": {
      "company": {
        "enabled": true,
        "required": false
      }
    }
  }
}

