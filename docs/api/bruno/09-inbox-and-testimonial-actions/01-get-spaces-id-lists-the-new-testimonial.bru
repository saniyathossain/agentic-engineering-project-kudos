tests {
  const __setVar = (k, v) => bru.setVar(k, v);
  const __getVar = (k) => (bru.getVar(k) ?? bru.getEnvVar(k));
  const __status = res.getStatus();
  const __hdr = (n) => res.getHeader(n.toLowerCase());
  const __text = (typeof res.getBody() === 'string' ? res.getBody() : JSON.stringify(res.getBody()));
  const __setCookies = () => [].concat(res.getHeader('set-cookie') || []);
  let __j; try { __j = (typeof res.getBody() === 'object' && res.getBody() !== null ? res.getBody() : JSON.parse(res.getBody())); } catch (e) { __j = undefined; }
  const __get = (o, p) => { const k = []; p.replace(/\['([^']+)'\]|\[(\d+)\]|([^.\[\]]+)/g, (m, a, b, c) => { k.push(a !== undefined ? a : b !== undefined ? Number(b) : c); return m; }); return k.reduce((x, y) => (x == null ? undefined : x[y]), o); };
  const __again = false;
  if (!__again) {
    test('echoes X-Request-ID', function () { expect(__hdr('X-Request-ID')).to.equal(__getVar('requestId')); });
    test("status is 200", function () { expect([200]).to.include(__status); });
    test("json props.testimonials.data len 1", function () { expect(__get(__j, "props.testimonials.data")).to.be.an('array'); expect(__get(__j, "props.testimonials.data").length).to.equal(1); });
    test("json props.testimonials.data[0].status eq \"pending\"", function () { expect(__get(__j, "props.testimonials.data[0].status")).to.deep.equal("pending"); });
    test("json props.testimonials.data[0].respondent_email eq \"ada@example.com\"", function () { expect(__get(__j, "props.testimonials.data[0].respondent_email")).to.deep.equal("ada@example.com"); });
    test("json props.testimonials.data[0].body eq \"Great stuff from {{spaceName}}\"", function () { expect(__get(__j, "props.testimonials.data[0].body")).to.deep.equal("Great stuff from " + __getVar("spaceName")); });
    test("json props.testimonials.data[0].is_favorite eq false", function () { expect(__get(__j, "props.testimonials.data[0].is_favorite")).to.deep.equal(false); });
    test("json props.counts.pending eq 1", function () { expect(__get(__j, "props.counts.pending")).to.deep.equal(1); });
    test("json props.counts.all eq 1", function () { expect(__get(__j, "props.counts.all")).to.deep.equal(1); });
  }
}

docs {
  HTML tags are stripped on submit: `<b>` is gone. The owner's view includes the respondent email.

  Mode: inertia. Expected status: 200.

  Skipped when these variables are empty: spaceId.
}
