  for (const __c of [].concat(res.getHeader('set-cookie') || [])) { const __m = /^XSRF-TOKEN=([^;]+)/.exec(__c); if (__m) { __setVar('xsrfToken', decodeURIComponent(__m[1])); } }
  { const __v = __get(__j, "props.testimonials.data[0].public_id"); if (__v !== undefined && __v !== null) { __setVar("testimonialId", String(__v)); } }
