tests {
  const __setVar = (k, v) => bru.setVar(k, v);
  const __getVar = (k) => (bru.getVar(k) ?? bru.getEnvVar(k));
  const __status = res.getStatus();
  const __hdr = (n) => res.getHeader(n.toLowerCase());
  const __text = (typeof res.getBody() === 'string' ? res.getBody() : JSON.stringify(res.getBody()));
  const __setCookies = () => [].concat(res.getHeader('set-cookie') || []);
  let __j; try { __j = (typeof res.getBody() === 'object' && res.getBody() !== null ? res.getBody() : JSON.parse(res.getBody())); } catch (e) { __j = undefined; }
  const __get = (o, p) => { const k = []; p.replace(/\['([^']+)'\]|\[(\d+)\]|([^.\[\]]+)/g, (m, a, b, c) => { k.push(a !== undefined ? a : b !== undefined ? Number(b) : c); return m; }); return k.reduce((x, y) => (x == null ? undefined : x[y]), o); };
  const __again = (bru.getVar("loop127") || '0') !== '0';
  if (!__again) {
    test('echoes X-Request-ID', function () { expect(__hdr('X-Request-ID')).to.equal(__getVar('requestId')); });
    test("status is 422", function () { expect([422]).to.include(__status); });
    test("json errors.email[0] match \"^Too many login attempts\\\\. Please try again in \\\\d+ seconds\\\\.$\"", function () { expect(String(__get(__j, "errors.email[0]"))).to.match(new RegExp("^Too many login attempts\\. Please try again in \\d+ seconds\\.$")); });
