meta {
  name: POST /{slug} with a bad rating and a disabled field is 422
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/{{spaceSlug}}
  body: json
  auth: none
}

headers {
  X-Request-ID: {{requestId}}
  Accept: application/json
  X-XSRF-TOKEN: {{xsrfToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Ada",
    "email": "ada@example.com",
    "body": "Nice one",
    "consent": true,
    "rating": 9,
    "title": "CEO"
  }
}

script:pre-request {
  const __setVar = (k, v) => bru.setVar(k, v);
  const __getVar = (k) => (bru.getVar(k) ?? bru.getEnvVar(k));
  // Generated by docs/api/build.py. Do not edit by hand.
  __setVar('requestId', 'kudos-api-' + Date.now().toString(36) + Math.random().toString(36).slice(2, 8));
  if (!__getVar('runId')) { const __id = Date.now().toString(36); __setVar('runId', __id); __setVar('spaceName', 'API Probe ' + __id); }
  if (!__getVar("spaceSlug") || __getVar("spaceSlug") === 'false') { bru.runner.skipRequest(); }
  req.setMaxRedirects(0);
}

